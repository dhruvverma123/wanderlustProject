<% layout("/layouts/boilerplate.ejs") %>
<!--  -->

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter {
    margin-right: 2rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
    text-align: center;
    opacity: 0.8;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
  }

  .gst {
    display: none;
  }

  .checkbox {
    border: 1px solid black;
    height: 3.25rem;
    border-radius: 1rem;
    padding: 0.7rem 0.7rem 2.2rem 0.7rem;
    margin-left: 2rem;
    margin-top: -0.8rem;
  }
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>mountain</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-city"></i></div>
    <p>iconic cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </div>
  <div class="checkbox">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        id="flexSwitchCheckDefault"
      />
      <label class="form-check-label" for="flexSwitchCheckDefault"
        >Display total after taxes</label
      >
    </div>
  </div>
</div>
<div class="row row-cols-lg-6 row-cols-md-3 row-cols-sm-1">
  <% for(let listing of allListings){%>
  <div class="card card-index">
    <a href="/listings/<%=listing._id%>" class="listing-link">
      <img
        src="<%=listing.image.url%>"
        class="card-img-top index-img"
        alt="house image"
        style="height: 10rem"
        ;
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text img-title">
          <b id="bold-text"><%=listing.title%></b><br />
          &#8377;<%=listing.price.toLocaleString()%> / night
          <i class="gst">&nbsp;&nbsp; 25% GST</i>
        </p>
      </div>
    </a>
  </div>
  <%}%>
</div>
<!-- col  -->

<script>
  let taxSwitches = document.getElementById("flexSwitchCheckDefault");
  taxSwitches.addEventListener("click", () => {
    let gst = document.getElementsByClassName("gst");
    for (let data of gst) {
      if (data.style.display != "inline") {
        data.style.display = "inline";
      } else {
        data.style.display = "none";
      }
    }
  });
</script>
