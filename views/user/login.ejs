<% layout("/layouts/boilerplate.ejs")%>
<div class="row">
  <div class="col-6 offset-3">
    <div>
      <h2 class="col-6 mb-3 mt-2">Login</h2>
    </div>
    <form action="/login" method="POST" novalidate class="needs-validation">
      <div>
        <label class="form-label" for="username">Username</label>
        <input
          class="form-control"
          id="username"
          type="text"
          name="username"
          required
        />
      </div>
      <div>
        <label for="password" class="form-label mt-2">Password</label>
        <input
          class="form-control"
          type="password"
          name="password"
          id="password"
          required
        />
      </div>
      <button class="btn btn-success mt-3">Login</button>
    </form>
  </div>
</div>
